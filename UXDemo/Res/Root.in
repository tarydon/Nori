TOPMENU [
  MENU "File" [
    MENU New "Ctrl N" { DoFileNew (); }
    MENU Open "Ctrl O" { DoFileOpen (); }
    if (MRUList.Count > 0) {
      MENU "Open Recent" [
        for (int i = 0; i < Math.Min (MRUList.Count, 9); i++) {
          var file = MRUList[i];
          MENU $"{file}" $"Ctrl {i + 1}" .Key=i { DoFileOpen (file); }
        }
      ]
    }
    SEPARATOR
    MENU Save "Ctrl S" (CurrentPart is null)
      .Tip=(DISABLED ? "No active part" : "Save the current Part")
      { DoFileSave (); }
    MENU Export (CurrentPart is null) .Tip=(DISABLED ? "No part to export" : "") [
      if (CurrentPart?.Is2D == true) {
        MENU "To DXF" { DoFileExport ("DXF"); }
        .Tip="Export Part to DXF file"
        MENU "To GEO" { DoFileExport ("GEO"); }
        .Tip="Export part drawing to GEO format"
      }
      if (CurrentPart?.Is3D == true) {
        MENU "To IGES" { DoFileExport ("IGES"); }
        MENU "To STEP" { DoFileExport ("STEP"); }
      }
    ]
    SEPARATOR
    MENU Exit "Alt F4" { DoExit (); }
  ]
  MENU "Edit" [
    MENU $"Undo {NextUndo}" "Ctrl Z" (NextUndo is null) { DoUndo (); }
    MENU $"Redo {NextRedo}" "Ctrl Y" (NextRedo is null) { DoRedo (); }
    SEPARATOR
    MENU Cut "Ctrl X" { DoCut (); }
    MENU Copy "Ctrl C" { DoCopy (); }
    MENU Paste "Ctrl P" { DoPaste (); }
  ]
  MENU "Demos" [
    MENU "Dialog..." { DoDialog (); }
  ]
]
