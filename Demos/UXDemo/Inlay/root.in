TOPMENU [
  MENU "File" [
    MENU New "Ctrl N" .Icon=FileNew .Tip="Create a new Part"
      { DoFileNew (); }
    MENU Open "Ctrl O" .Icon=FileOpen .Tip="Open a 2D or 3D Part from file"
      { DoFileOpen (); }
    if (MRUList.Count > 0) {
      MENU "Open Recent" [
        for (int i = 0; i < Math.Min (MRUList.Count, 9); i++) {
          var file = MRUList[i];
          MENU $"{file}" $"Ctrl {i + 1}" { DoFileOpen (file); }
        }
      ]
    }
    SEPARATOR
    MENU Save "Ctrl S" (CurrentPart is null)
      .Icon=FileSave
      .Tip=(DISABLED ? "No active part" : "Save the current Part")
      { DoFileSave (); }
    MENU Export (CurrentPart is null) [
      if (CurrentPart?.Is2D == true) {
        MENU "To DXF" { DoFileExport ("DXF"); }
        MENU "To GEO" { DoFileExport ("GEO"); }
      }
      if (CurrentPart?.Is3D == true) {
        MENU "To IGES" { DoFileExport ("IGES"); }
        MENU "To STEP" { DoFileExport ("STEP"); }
      }
    ]
    SEPARATOR
    MENU Exit "Ctrl X" { }
  ]
  MENU "Edit" [
    MENU Cut {}
    MENU Copy {}
    MENU Paste {}
  ]
  MENU "Help" [
    MENU "About..."
  ]
]
